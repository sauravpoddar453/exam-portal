# =================================================================
# Online Examination Portal - Backend Environment Variables Template
# =================================================================
# Copy this file to .env in your server directory for local development,
# or set these environment variables in your Render backend service dashboard.

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database Connection (MongoDB Atlas for Production)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:yourpassword@cluster0.mongodb.net/exam_portal?retryWrites=true&w=majority

# 3. Authentication & JWT Security
JWT_SECRET=your_super_secret_jwt_key_please_change_in_production_2026
JWT_EXPIRE=30d

# 4. Frontend Client URL (For CORS & Email Link Generation)
# Support comma-separated URLs if hosting on multiple domains/previews
CLIENT_URL=http://localhost:5173

# 5. Email Notification Service (Gmail SMTP / Nodemailer)
# Use a Gmail App Password if using Gmail (myaccount.google.com/apppasswords)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# 6. AI Features (Optional - For AI Document Parser & Auto-Evaluation)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key
